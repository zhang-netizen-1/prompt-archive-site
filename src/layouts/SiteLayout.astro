---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { getAllCases, getAllNotes, getAllCollections } from '../lib/catalog';

const footerStats = {
  caseCount: getAllCases().length,
  filmCount: getAllCases().filter((c) => c.evidence === 'film-attached').length,
  noteCount: getAllNotes().length,
  collectionCount: getAllCollections().length,
};
const { caseCount, filmCount, noteCount, collectionCount } = footerStats;

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'images' | 'videos' | 'notes' | 'cases';
}
const { title, description = '可浏览、可检索、可复制的 AI 图像与视频提示词案例。', activeNav = 'home' } = Astro.props;
const navItems = [
  { href: '/images/', label: '图像案例', no: '01', key: 'images' },
  { href: '/videos/', label: '视频案例', no: '02', key: 'videos' },
  { href: '/notes/', label: '方法笔记', no: '03', key: 'notes' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <span class="brand-glyph">PA</span>
          <span class="brand-name">AI 提示词档案馆</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a href={item.href} aria-current={activeNav === item.key ? 'page' : undefined}>
              {item.label}
              <span class="nav-no">{item.no}</span>
            </a>
          ))}
        </nav>
        <div class="header-cta">
          <a class="header-search-link" href="/cases/" aria-label="全站搜索案例">
            <Icon name="search" size={15} />
            <span>搜索</span>
            <span class="nav-no">04</span>
          </a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="brand" href="/">
              <span class="brand-glyph">PA</span>
              <span class="brand-name">AI 提示词档案馆</span>
            </a>
            <p class="footer-desc">可浏览、可检索、可复制的 AI 图像与视频提示词案例库。每个完整案例一个独立页面，提示词与 Wiki 原文逐字一致。</p>
          </div>
          <nav class="footer-col" aria-label="页脚导航">
            <p class="footer-label">浏览</p>
            <a href="/images/">图像案例</a>
            <a href="/videos/">视频案例</a>
            <a href="/notes/">方法笔记</a>
            <a href="/cases/">全站搜索</a>
          </nav>
          <div class="footer-col">
            <p class="footer-label">本馆收录</p>
            <p class="footer-stat"><span>案例</span><b>{caseCount}</b></p>
            <p class="footer-stat"><span>附实测成片</span><b>{filmCount}</b></p>
            <p class="footer-stat"><span>方法笔记</span><b>{noteCount}</b></p>
            <p class="footer-stat"><span>合集</span><b>{collectionCount}</b></p>
          </div>
        </div>
        <div class="footer-bottom">
          <p>「作者称已测试」表示来源声明，本站未复测。</p>
          <p>PA·ARCHIVE © 2026</p>
        </div>
      </div>
    </footer>
    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 8px;
        z-index: 100;
        background: var(--bg-raised);
        color: var(--text);
        padding: 10px 16px;
      }
      .skip-link:focus { left: 8px; }
    </style>
  </body>
  <script>
    // 瀑布流：把 [data-masonry] 的卡片按行序轮转分配到 N 个列容器，
    // 列高取最高列，卡片完整呈现、不会被后续区块遮盖。
    function layoutMasonry() {
      document.querySelectorAll('[data-masonry]').forEach((grid) => {
        const cards = Array.from(grid.querySelectorAll(':scope > .m-cols > .m-col > *, :scope > *:not(.m-cols)'));
        grid.querySelectorAll('.m-cols').forEach((w) => w.remove());
        if (cards.length === 0) return;
        const cols = window.matchMedia('(max-width: 767px)').matches ? 1
          : window.matchMedia('(max-width: 1199px)').matches ? 2 : 3;
        const wrap = document.createElement('div');
        wrap.className = 'm-cols';
        const colDivs = Array.from({ length: cols }, () => {
          const d = document.createElement('div');
          d.className = 'm-col';
          return d;
        });
        cards.forEach((el, i) => colDivs[i % cols].appendChild(el));
        grid.appendChild(wrap);
        colDivs.forEach((d) => wrap.appendChild(d));
      });
    }
    window.refreshMasonry = layoutMasonry;
    layoutMasonry();
    let rzTimer;
    window.addEventListener('resize', () => { clearTimeout(rzTimer); rzTimer = setTimeout(layoutMasonry, 150); });
  </script>
  <script>
    // 卡片跟手倾斜：角度随指针相对卡片中心的位置连续变化；
    // 仅鼠标（pointerType=mouse 且 fine pointer）；减弱动态时完全静止。
    (() => {
      const MAX_DEG = 4.5;          // 最大倾斜角
      const PERSPECTIVE = 1100;
      const CARD_SEL = '.case-card, .note-card, .note-list-card';
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      let card = null;              // 当前作用中的卡片
      let rect = null;
      let returnTimer = 0;

      const reducedChange = () => { if (reduced.matches) reset(); };
      reduced.addEventListener?.('change', reducedChange);

      function reset() {
        if (!card) return;
        const el = card;
        el.classList.remove('tilt-active');
        el.classList.add('tilt-return');   // 平滑过渡回 CSS 基础角
        el.style.transform = '';
        clearTimeout(returnTimer);
        returnTimer = setTimeout(() => el.classList.remove('tilt-return'), 320);
        card = null; rect = null;
      }

      document.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse' || !e.isPrimary || reduced.matches) return;
        const target = e.target instanceof Element ? e.target.closest(CARD_SEL) : null;
        if (target !== card) {
          reset();
          if (!target) return;
          card = target;
          rect = card.getBoundingClientRect();
          card.classList.add('tilt-active');
          card.classList.remove('tilt-return');
        }
        if (!card || !rect) return;
        const px = (e.clientX - rect.left) / rect.width - 0.5;   // -0.5 ~ 0.5
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        const ry = Math.max(-1, Math.min(1, px * 2)) * MAX_DEG;
        const rxx = Math.max(-1, Math.min(1, py * 2)) * -MAX_DEG;
        card.style.transform =
          `perspective(${PERSPECTIVE}px) rotateX(${rxx.toFixed(3)}deg) rotateY(${ry.toFixed(3)}deg) translateY(-3px)`;
      }, { passive: true });

      document.addEventListener('pointerleave', () => reset());
      document.addEventListener('pointerdown', (e) => {
        const target = e.target instanceof Element ? e.target.closest(CARD_SEL) : null;
        if (target !== card) reset();
      }, { passive: true });
      window.addEventListener('blur', () => reset());
      window.addEventListener('scroll', () => reset(), { passive: true });
    })();
  </script>
</html>
