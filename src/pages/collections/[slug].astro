---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getAllCollections, getCollection, getCase } from '../../lib/catalog';

export function getStaticPaths() {
  return getAllCollections().map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

interface Props {
  collection: ReturnType<typeof getCollection>;
}
const { collection } = Astro.props;
if (!collection) return Astro.redirect('/404');
const cases = collection.caseSlugs.map((s) => getCase(s)).filter((c) => c != null);
---
<SiteLayout title={`${collection.title} · 合集`} description={collection.description} darkHero>
  <section class="collection-hero">
    <div class="container">
      <p class="collection-source">合集 · {collection.sourceDisplay}</p>
      <h1>{collection.title}</h1>
      <p>{collection.description}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>本合集案例（{cases.length}）</h2>
        <span style="font-size:14px;color:var(--text-2)">每个案例都有独立页面，可从下方直接进入</span>
      </div>
      <div class="grid-cases" data-masonry>
        {cases.map((item) => item && <CaseCard item={item} />)}
      </div>
    </div>
  </section>
</SiteLayout>
