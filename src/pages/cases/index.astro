---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import CaseCard from '../../components/CaseCard.astro';
import ScenarioChips from '../../components/ScenarioChips.astro';
import RecentCopies from '../../components/RecentCopies.astro';
import { getAllCases, getFilterOptions } from '../../lib/catalog';

const cases = getAllCases();
const topics = getFilterOptions(cases, 'topic');
const mediums = getFilterOptions(cases, 'medium');
---
<SiteLayout title="全站搜索 · AI 提示词档案馆" activeNav="cases">
  <div class="container">
    <section class="case-header" style="padding-bottom:0">
      <h1 class="page-title">全站搜索</h1>
      <p class="case-summary">同时搜索图像与视频案例：覆盖标题、摘要、标签与提示词正文。结果卡标注图像或视频，以及是否附有成片、示例或参考图。</p>
    </section>

    <ScenarioChips filter />
    <RecentCopies />
    <div class="toolbar">
      <div class="search-row">
        <Icon name="search" size={18} />
        <input type="search" data-search-input placeholder="输入关键词，例如：微表情、变装、故事板、追逐…" aria-label="搜索案例" autofocus />
      </div>
      <label>
        媒介
        <select data-filter-medium aria-label="按媒介筛选">
          <option value="">全部</option>
          {mediums.map(o => <option value={o.value}>{o.label}</option>)}
        </select>
      </label>
      <label>
        主题
        <select data-filter-topic aria-label="按主题筛选">
          <option value="">全部主题</option>
          {topics.map(o => <option value={o.value}>{o.label}</option>)}
        </select>
      </label>
      <button class="reset" type="button" data-filter-reset>清空搜索与筛选</button>
      <span class="result-count" data-result-count aria-live="polite">{cases.length} 个案例</span>
    </div>

    <div class="grid-cases archive-grid" data-search-grid data-masonry data-base-path={import.meta.env.PUBLIC_SITE_BASE_PATH ?? ''}>
      {cases.map(item => <CaseCard item={item} search={true} />)}
    </div>
    <div class="load-more-row"><button class="btn btn-ghost" type="button" data-load-more hidden>加载更多</button></div>
    <div class="empty-state" data-empty hidden>
      <p class="empty-title"><strong>没有匹配的案例</strong></p>
      <p class="empty-hint">换一个关键词，或清空搜索与筛选再试。</p>
      <button class="btn btn-ghost" type="button" data-filter-reset>清空搜索与筛选</button>
    </div>
  </div>

  <style>
    .search-row {
      display: flex;
      align-items: center;
      gap: var(--sp-8);
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 0;
      padding: var(--sp-4) var(--sp-16);
      flex: 1 1 320px;
      color: var(--ink-2);
      min-height: 48px;
      min-width: 0;
    }
    .search-row input {
      border: none;
      background: none;
      font: inherit;
      font-size: var(--fs-16);
      color: var(--ink);
      width: 100%;
      min-width: 0;
    }
    .search-row input:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }
  </style>

  <script>
    import { PAGE_SIZE, pageMatches, highlightParts } from '../../lib/catalog-display.mjs';
    const input = document.querySelector<HTMLInputElement>('[data-search-input]')!;
    const mediumSelect = document.querySelector<HTMLSelectElement>('[data-filter-medium]')!;
    const topicSelect = document.querySelector<HTMLSelectElement>('[data-filter-topic]')!;
    const grid = document.querySelector<HTMLElement>('[data-search-grid]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const count = document.querySelector<HTMLElement>('[data-result-count]')!;
    const more = document.querySelector<HTMLButtonElement>('[data-load-more]')!;
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.case-card')).map(card => ({
      card, medium: card.dataset.medium, topic: card.dataset.topic,
      searchText: card.dataset.search,
      title: card.querySelector<HTMLElement>('.card-detail-link')!,
      summary: card.querySelector<HTMLElement>('.card-summary')!,
      titleText: card.querySelector('.card-title')!.textContent ?? '',
      summaryText: card.querySelector('.card-summary')!.textContent ?? '',
    }));
    let limit = PAGE_SIZE;

    function highlight(target: HTMLElement, text: string, query: string) {
      target.replaceChildren(...highlightParts(text, query).map(part => {
        if (!part.match) return document.createTextNode(part.text);
        const mark = document.createElement('mark');
        mark.textContent = part.text;
        return mark;
      }));
    }

    function apply(reset = true) {
      if (reset) limit = PAGE_SIZE;
      const query = input.value.trim();
      const { matches, shown, remaining } = pageMatches(items, {
        query, medium: mediumSelect.value, topic: topicSelect.value,
      }, limit);
      const visible = new Set(shown);
      for (const item of items) {
        item.card.hidden = !visible.has(item);
        if (!item.card.hidden) {
          highlight(item.title, item.titleText, query);
          highlight(item.summary, item.summaryText, query);
        }
      }
      document.querySelectorAll<HTMLButtonElement>('[data-scenario-topic]').forEach(chip => {
        chip.setAttribute('aria-pressed', String(chip.dataset.scenarioTopic === topicSelect.value));
      });
      count.textContent = `${matches.length} 个案例`;
      empty.hidden = matches.length !== 0;
      grid.hidden = matches.length === 0;
      more.hidden = remaining === 0;
      more.textContent = `加载更多（还有 ${remaining} 条）`;
      window.refreshMasonry?.();
      const params = new URLSearchParams();
      if (query) params.set('q', query);
      if (mediumSelect.value) params.set('medium', mediumSelect.value);
      if (topicSelect.value) params.set('topic', topicSelect.value);
      history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
    }

    let debounce: ReturnType<typeof setTimeout>;
    input.addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(() => apply(), 120);
    });
    mediumSelect.addEventListener('change', () => apply());
    topicSelect.addEventListener('change', () => apply());
    document.querySelectorAll<HTMLButtonElement>('[data-scenario-topic]').forEach(chip => {
      chip.addEventListener('click', () => {
        clearTimeout(debounce);
        topicSelect.value = chip.dataset.scenarioTopic ?? '';
        apply();
      });
    });
    more.addEventListener('click', () => { limit += PAGE_SIZE; apply(false); });
    document.querySelectorAll('[data-filter-reset]').forEach(btn => {
      btn.addEventListener('click', () => {
        clearTimeout(debounce);
        input.value = '';
        mediumSelect.value = '';
        topicSelect.value = '';
        apply();
      });
    });
    const params = new URLSearchParams(location.search);
    input.value = params.get('q') ?? '';
    mediumSelect.value = params.get('medium') ?? '';
    topicSelect.value = params.get('topic') ?? '';
    apply();
  </script>
</SiteLayout>
