---
import SiteLayout from '../layouts/SiteLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import NotePreview from '../components/NotePreview.astro';
import { getFeaturedCases, getAllNotes, getAllCases } from '../lib/catalog';
import type { CaseItem, NoteItem } from '../lib/catalog';

// 混合精选：视频案例、图像案例与方法笔记交错排列
type FeaturedEntry = { kind: 'case' | 'note'; item: CaseItem | NoteItem };
const featuredCases = getFeaturedCases();
const featuredNotes = getAllNotes().filter((n) => n.featured);
const featured: FeaturedEntry[] = [];
let ci = 0, ni = 0;
const pattern = ['case', 'case', 'note', 'case', 'case', 'note', 'case', 'note', 'case'];
for (const kind of pattern) {
  if (kind === 'case' && ci < featuredCases.length) featured.push({ kind: 'case', item: featuredCases[ci++] });
  else if (kind === 'note' && ni < featuredNotes.length) featured.push({ kind: 'note', item: featuredNotes[ni++] });
  else if (ci < featuredCases.length) featured.push({ kind: 'case', item: featuredCases[ci++] });
  else if (ni < featuredNotes.length) featured.push({ kind: 'note', item: featuredNotes[ni++] });
}
const filmCount = getAllCases().filter((c) => c.evidence === 'film-attached').length;
const notes = getAllNotes();
const heroPhotoCase = featured.find((e) => e.kind === 'case' && e.item.media.some((m) => m.poster))?.item
  ?? featured.find((e) => e.kind === 'case' && e.item.media.length > 0)?.item;
const heroPhotoItem = heroPhotoCase
  ? (heroPhotoCase.media.find((m) => m.poster) ?? heroPhotoCase.media[0])
  : null;
---
<SiteLayout title="AI 提示词档案馆 · 图像与视频提示词案例" activeNav="home">
  <section class="hero">
    <div class="container">
      <div>
        <p class="hero-kicker">The Prompt Archive</p>
        <h1>先看真实的图像与成片，<br />再<span class="hl">复制提示词原文</span>。</h1>
        <p class="hero-sub">
          案例分「图像案例」与「视频案例」两类，共用搜索与方法笔记。每个完整案例一个独立页面，
          生成结果、实测成片与输入参考图分别标注，不混淆身份。
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/cases/">浏览案例 <span class="arrow">&gt;</span></a>
          <a class="btn btn-ghost" href="/notes/">方法笔记</a>
        </div>
      </div>
      <div class="hero-collage" aria-hidden="true">
        {heroPhotoCase && heroPhotoItem && (
          <figure class="hero-photo" style="margin:0">
            <img src={heroPhotoItem.poster ?? heroPhotoItem.url} alt="" loading="eager" />
            <figcaption class="photo-cap">
              <span>{heroPhotoCase.title}</span>
              <span>{heroPhotoCase.archiveNo}</span>
            </figcaption>
          </figure>
        )}
        <div class="hero-card">
          <h3>馆藏速览</h3>
          <div class="hero-card-row"><span>案例总数</span><b>{getAllCases().length}</b></div>
          <div class="hero-card-row"><span>附实测成片</span><b>{filmCount}</b></div>
          <div class="hero-card-row"><span>方法笔记</span><b>{notes.length}</b></div>
          <div class="hero-card-row"><span>提示词逐字核对</span><b>✓</b></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="featured-heading">精选案例</h2>
        <span class="head-note">视频、图像与方法笔记混合精选，媒体身份在卡片上标注</span>
        <a class="more" href="/cases/">全部案例 →</a>
      </div>
      <div class="grid-cases grid-featured" data-masonry>
        {featured.map((entry) => entry.kind === 'case'
          ? <CaseCard item={entry.item as CaseItem} eager={true} />
          : <NotePreview note={entry.item as NoteItem} />)}
      </div>
    </div>
  </section>

</SiteLayout>

