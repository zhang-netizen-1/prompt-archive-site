---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getAllNotes } from '../../lib/catalog';

const notes = getAllNotes();
const categories = ['模板', '变量库', '方法', '规则'];
const grouped = categories
  .map((cat) => ({ cat, items: notes.filter((n) => n.category === cat) }))
  .filter((g) => g.items.length > 0);
---
<SiteLayout title="方法笔记 · AI 提示词档案馆" activeNav="notes">
  <div class="container">
    <section class="case-header" style="padding-bottom:0">
      <h1 style="font-size:36px">方法笔记</h1>
      <p class="case-summary">
        提示词结构、模板与变量库：来自 Wiki 原文的转换预览。带占位符的骨架与取值集合归入这里，不冒充实测案例。
      </p>
    </section>
    {grouped.map((group) => (
      <section class="section" aria-labelledby={`cat-${group.cat}`}>
        <div class="section-head">
          <h2 id={`cat-${group.cat}`}>{group.cat}（{group.items.length}）</h2>
        </div>
        <div class="note-list-grid">
          {group.items.map((note) => (
            <a class="note-list-card" href={`/notes/${note.slug}/`}>
              <span style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.12em;color:var(--text-2)">
                {note.medium === 'image' ? '图像' : note.medium === 'video' ? '视频' : '共用'}
              </span>
              <h2>{note.title}</h2>
              <p>{note.summary}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</SiteLayout>
