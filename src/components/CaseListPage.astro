---
import SiteLayout from '../layouts/SiteLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import ListFilter from '../components/ListFilter.astro';
import { getCasesByMedium, getFilterOptions, type Medium } from '../lib/catalog';

interface Props {
  medium: Medium;
  siteTitle: string;
  intro: string;
  collectionLinks?: { href: string; label: string }[];
}
const { medium, siteTitle, intro, collectionLinks = [] } = Astro.props;
const cases = getCasesByMedium(medium);
const topics = getFilterOptions(cases, 'topic').map(o => o.value);
const evidenceOptions = getFilterOptions(cases, 'evidence');
---
<SiteLayout title={`${siteTitle} · AI 提示词档案馆`} description={intro} activeNav={medium === 'image' ? 'images' : 'videos'}>
  <div class="container">
    <section class="case-header" style="padding-bottom:0">
      <h1 class="page-title">{siteTitle}</h1>
      <p class="case-summary">{intro}</p>
      {collectionLinks.length > 0 && (
        <div class="case-tags">
          {collectionLinks.map((c) => <a class="tag" style="text-decoration:none" href={c.href}>{c.label}</a>)}
        </div>
      )}
    </section>
    <ListFilter topics={topics} evidenceOptions={evidenceOptions} topicParam={Astro.url.searchParams.get('topic') ?? ''} />
    <div class="grid-cases archive-grid" data-case-grid data-masonry>
      {cases.map((item) => <CaseCard item={item} />)}
    </div>
    <div class="load-more-row"><button class="btn btn-ghost" type="button" data-load-more hidden>加载更多</button></div>
  </div>
</SiteLayout>
