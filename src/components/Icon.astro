  external: '<path d="M8.5 4.5H4.8A1.3 1.3 0 0 0 3.5 5.8v9.4a1.3 1.3 0 0 0 1.3 1.3h9.4a1.3 1.3 0 0 0 1.3-1.3v-3.7"/><path d="M12.5 3.5h4v4"/><line x1="16.2" y1="3.8" x2="9.5" y2="10.5"/>',
  film: '<rect x="3" y="3.5" width="14" height="13" rx="1.5"/><line x1="3" y1="7.4" x2="17" y2="7.4"/><line x1="3" y1="12.6" x2="17" y2="12.6"/><line x1="7" y1="3.5" x2="7" y2="16.5"/><line x1="13" y1="3.5" x2="13" y2="16.5"/>',
  link: '<path d="M8.5 11.5a4 4 0 0 1 0-5.6l1.4-1.4a4 4 0 0 1 5.6 5.6l-1.4 1.4"/><path d="M11.5 8.5a4 4 0 0 1 0 5.6l-1.4 1.4a4 4 0 0 1-5.6-5.6l1.4-1.4"/>',
};
const d = paths[name];
---

<span class={className} style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={d} />
</span>
