  image: '<rect x="3" y="4" width="14" height="12" rx="1.5"/><circle cx="7.4" cy="8.4" r="1.4"/><path d="M3 13.2l3.8-3.4 3.2 2.8 2.6-2.2 4.4 3.6"/>',
  video: '<rect x="2.5" y="5" width="12.5" height="10" rx="1.5"/><path d="M15 9l4.5-2.6v7.2L15 11z"/>',
  play: '<path d="M7 4.8v10.4a.6.6 0 0 0 .92.5l8.1-5.2a.6.6 0 0 0 0-1L7.92 4.3a.6.6 0 0 0-.92.5z"/>',
  copy: '<rect x="8" y="8" width="10.5" height="10.5" rx="1.5"/><path d="M5.5 13.5h-.7A1.8 1.8 0 0 1 3 11.7V4.8A1.8 1.8 0 0 1 4.8 3h6.9a1.8 1.8 0 0 1 1.8 1.8v.7"/>',
  check: '<path d="M4.5 12.5l4.4 4.4L19.5 6.3"/>',
  note: '<path d="M5 4.5A1.5 1.5 0 0 1 6.5 3h11A1.5 1.5 0 0 1 19 4.5v15l-3.5-2.4-3.5 2.4-3.5-2.4L5 19.5z"/><line x1="8.5" y1="8" x2="15.5" y2="8"/><line x1="8.5" y1="11.5" x2="13.5" y2="11.5"/>',
  'arrow-right': '<line x1="4" y1="10" x2="16.4" y2="10"/><path d="M12 5.4l4.8 4.6-4.8 4.6"/>',
  'arrow-left': '<line x1="17" y1="10" x2="4.6" y2="10"/><path d="M9 5.4L4.2 10l4.8 4.6"/>',
